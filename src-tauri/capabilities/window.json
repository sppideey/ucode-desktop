{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "window-controls",
  "description": "The title bar on the loading page and on the page served by `ucode app --serve` (127.0.0.1, any port): drag, minimise, maximise, close, and the resize event. Nothing else: no shell, no files.",
  "windows": ["main"],
  "local": true,
  "remote": {
    "urls": ["http://127.0.0.1:*/*", "http://localhost:*/*"]
  },
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
