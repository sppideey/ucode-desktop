{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ucode",
  "version": "1.3.0",
  "identifier": "dev.ucode.desktop",
  "build": {
    "frontendDist": "loading"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../server/": "server/",
      "../out/": "out/",
      "../engine/": "engine/",
      "../package.json": "package.json"
    },
    "targets": [
      "nsis"
    ],
    "publisher": "om dixit",
    "copyright": "AGPL-3.0",
    "license": "AGPL-3.0-only",
    "category": "DeveloperTool",
    "shortDescription": "ucode, a free coding agent - made and tested by om dixit",
    "longDescription": "ucode desktop: ucode in its own window, the free coding agent. It needs Node.js (nodejs.org); ucode comes with it. Made and tested by om dixit.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ5NzA5MTNBRDA0NEIyN0MKUldSOHNrVFFPcEZ3U1ozWDhRUExRbEdpK3labUNPUDFySTE5a2xSRlZOSlhlZ1pEQlNtbUJoUEkK",
      "endpoints": [
        "https://github.com/sppideey/ucode-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
